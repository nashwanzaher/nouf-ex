%% مراجعة واقعية لتدفقات المستخدم — nouf-ex
%% تاريخ التحديث: 2026-07-09
%% الهدف: توضيح مسارات المستخدم الرئيسية بعد الإصلاحات

flowchart TD
    %% ====== البداية والزائر ======
    START([المستخدم يفتح التطبيق]) --> HOMEPAGE[الصفحة الرئيسية / Home]
    HOMEPAGE --> BROWSE{تصفح المنتجات}
    BROWSE --> SEARCH[صفحة البحث /search]
    BROWSE --> CATEGORIES[صفحة الفئات /categories]
    BROWSE --> DEALS[صفحة العروض /deals]
    BROWSE --> PRODUCT[صفحة تفاصيل المنتج /product/:id]

    %% ====== المصادقة ======
    subgraph AUTH["🔐 مصادقة المستخدم"]
        LOGIN[تسجيل الدخول /auth/login]
        REGISTER[إنشاء حساب /auth/register]
        FORGOT[نسيت كلمة المرور /auth/forgot-password]
        RESET[إعادة تعيين كلمة المرور /auth/reset-password]
        TWOFA[التحقق بخطوتين /auth/2fa]
    end

    HOMEPAGE -.->|زائر غير مسجل| GUEST_ACTIONS
    PRODUCT -.->|زائر غير مسجل| GUEST_ACTIONS

    subgraph GUEST_ACTIONS["👤 إجراءات الزائر"]
        ADD_CART_LOCAL[إضافة للسلة المحلية localStorage]
        ADD_WISHLIST_LOCAL[إضافة للمفضلة المحلية localStorage]
        GUEST_CHECKOUT[محاولة الشراء ← إعادة توجيه للتسجيل]
    end

    LOGIN -->|نجاح| CUSTOMER_HUB[منطقة العميل /customer]
    REGISTER -->|نجاح| CUSTOMER_HUB

    %% ====== السلة — مزامنة مع الخادم للمستخدم المسجل ======
    ADD_CART_LOCAL --> CART_VIEW[عرض السلة / CartContext]
    CART_VIEW --> CHECKOUT[صفحة الدفع /checkout]
    CUSTOMER_HUB --> CART_VIEW

    subgraph CART_SYNC["🛒 مزامنة السلة"]
        SYNC_LOGIN[عند تسجيل الدخول: دفع السلة المحلية + جلب السلة الخلفية]
        SERVER_ADD[ADD /api/cart]
        SERVER_UPDATE[PATCH /api/cart/:id]
        SERVER_REMOVE[DELETE /api/cart/:id]
        SERVER_CLEAR[DELETE /api/cart/clear/:userId]
    end

    CART_VIEW -.->|مستخدم مسجل| SYNC_LOGIN
    CART_VIEW -.->|مستخدم مسجل| SERVER_ADD
    CART_VIEW -.->|مستخدم مسجل| SERVER_UPDATE
    CART_VIEW -.->|مستخدم مسجل| SERVER_REMOVE
    CART_VIEW -.->|مستخدم مسجل| SERVER_CLEAR

    %% ====== الدفع والطلب ======
    CHECKOUT --> SELECT_ADDRESS[اختيار عنوان الشحن]
    SELECT_ADDRESS --> SHIPPING_METHOD[اختيار/حساب طريقة الشحن]
    SHIPPING_METHOD --> COUPON[تطبيق كوبون خصم]
    COUPON --> PAYMENT{اختيار طريقة الدفع}
    PAYMENT -->|نقداً عند الاستلام| PLACE_ORDER[إنشاء الطلب /api/orders]
    PAYMENT -->|بطاقة/محفظة| PAYMENT_GATEWAY[بوابة دفع خارجية]
    PAYMENT_GATEWAY -->|نجاح| PLACE_ORDER
    PLACE_ORDER --> ORDER_CONFIRMED[تأكيد الطلب + رقم الطلب]
    ORDER_CONFIRMED --> CUSTOMER_ORDERS[طلباتي /customer/orders]

    %% ====== بعد الشراء ======
    CUSTOMER_ORDERS --> TRACK_ORDER[تتبع الطلب]
    CUSTOMER_ORDERS --> REQUEST_REFUND[طلب استرداد /api/refunds]
    CUSTOMER_ORDERS --> OPEN_DISPUTE[فتح نزاع /api/disputes]
    CUSTOMER_ORDERS --> REVIEW_PRODUCT[كتابة مراجعة /api/reviews]

    %% ====== المتاجر ======
    PRODUCT --> STORE_PAGE[صفحة المتجر /store/:id]
    STORE_PAGE --> FOLLOW_STORE[متابعة/إلغاء متابعة المتجر /api/store-followers]
    STORE_PAGE --> MESSAGE_MERCHANT[مراسلة التاجر]

    %% ====== التاجر ======
    subgraph SELLER["🏪 لوحة التاجر"]
        SELLER_DASHBOARD[لوحة التحكم /seller]
        SELLER_PRODUCTS[إدارة المنتجات /seller/products]
        SELLER_ORDERS[إدارة الطلبات /seller/orders]
        SELLER_ANALYTICS[التحليلات /seller/analytics]
        SELLER_MESSAGES[الرسائل /messages]
    end

    SELLER_PRODUCTS --> CREATE_PRODUCT[إنشاء منتج /api/seller/products]
    SELLER_PRODUCTS --> UPDATE_PRODUCT[تعديل منتج]
    SELLER_ORDERS --> UPDATE_ORDER_STATUS[تحديث حالة الطلب]

    %% ====== المشرف ======
    subgraph ADMIN["🛡️ لوحة المشرف"]
        ADMIN_DASHBOARD[لوحة المشرف /admin]
        ADMIN_USERS[إدارة المستخدمين /admin/users]
        ADMIN_STORES[إدارة المتاجر /admin/stores]
        ADMIN_PRODUCTS[إدارة المنتجات /admin/all-products]
        ADMIN_ORDERS[إدارة الطلبات /admin/all-orders]
        ADMIN_DISPUTES[إدارة النزاعات /admin/disputes]
        ADMIN_REPORTS[التقارير /admin/reports]
        ADMIN_AUDIT[سجل التدقيق /admin/audit-log]
    end

    ADMIN_DISPUTES --> RESOLVE_DISPUTE[حل النزاع]
    ADMIN_ORDERS --> RESOLVE_REFUND[حل طلب الاسترداد]

    %% ====== الإشعارات ======
    CUSTOMER_HUB --> NOTIFICATIONS[الإشعارات /customer/notifications]
    SELLER_DASHBOARD --> NOTIFICATIONS

    %% ====== الألوان ======
    classDef fixed fill:#d4edda,stroke:#28a745,stroke-width:2px,color:#000
    classDef partial fill:#fff3cd,stroke:#ff9800,stroke-width:2px,color:#000
    classDef pending fill:#ffcccc,stroke:#cc0000,stroke-width:2px,color:#000

    CART_VIEW:::fixed
    FOLLOW_STORE:::fixed
    ADMIN_DISPUTES:::fixed
    COUPON:::fixed
    RESOLVE_REFUND:::fixed
    CREATE_PRODUCT:::fixed

    PAYMENT_GATEWAY:::partial
    GUEST_CHECKOUT:::partial

    %% ملاحظات
    NOTE_CART["✅ السلة تتزامن مع الخادم للمستخدم المسجل"]
    CART_VIEW -.-> NOTE_CART

    NOTE_FOLLOW["✅ متابعة/إلغاء متابعة المتاجر متاح الآن"]
    FOLLOW_STORE -.-> NOTE_FOLLOW

    NOTE_PAYMENT["⚠️ الدفع الإلكتروني يحتاج بوابة دفع حقيقية"]
    PAYMENT_GATEWAY -.-> NOTE_PAYMENT
