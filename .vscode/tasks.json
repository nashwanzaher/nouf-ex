		{
			"label": "🚀 Start Full Stack (Docker)",
			"type": "shell",
			"command": "docker compose up -d --build",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
