.env
.vs/
.vscode/*.log
node_modules/
bin/
obj/
dist/
build/
__pycache__/
*.pyc
.DS_Store
*.db
*.db-journal
*.db-shm
*.db-wal
*.log
coverage/
.env.local
app/server/index.js

# MCP server (TypeScript → JS)
mcp-server/dist/
mcp-server/node_modules/
mcp-server/.tmp*

# Continue (agent state caches, regenerated on every editor session)
.continue/

# PowerShell wrapper script outputs (regenerated on every run via `> $file`)
scripts/_*.out
scripts/_*.txt

# Local logs (e.g. logs/autostart.log from scripts/autostart.ps1)
logs/
*.log.*

# Playwright (e2e tests)
# test-results/ holds the per-test JSON Playwright writes after every
# run. The HTML report (playwright-report/) is in the project root and
# not gitignored because some teams commit the latest known-good report.
app/e2e/test-results/
app/playwright-report/
app/blob-report/
app/playwright/.cache/

# Playwright MCP tooling (in-editor browser navigation, console logs,
# screenshots). These are regenerated every time Copilot Chat uses the
# browser tool and have no value in version control.
.playwright-mcp/

# Vite dev-server cache (regenerated on every `vite` start; nothing to
# review). Lives next to vite.config.ts and is harmless to leave on
# disk, but should not be in version control.
.vite/

# Standalone screenshots captured during interactive debugging.
admin-dashboard.png
login-page-fixed.png
.playwright-mcp/
.t.txt
.l.txt
.p.txt
.d.txt

# Husky internal state (husky 9+ writes _/ files at git install time)
.husky/_/
.husky/.gitignore
