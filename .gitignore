# ============================================================================
# Standard ignore patterns
# ============================================================================
.env
.vs/
.vscode/*.log
node_modules/
bin/
obj/
dist/
build/
__pycache__/
*.pyc
.DS_Store
*.db
*.db-journal
*.db-shm
*.db-wal
*.log
coverage/
.env.local
app/server/index.js

# ============================================================================
# MkDocs (docs site generator)
# ============================================================================
site/                              # mkdocs build output
.mkdocs_*                          # strict-mode verbose logs
.venv/ venv/ env/                  # python virtualenv for docs build

# ============================================================================
# Python tooling caches
# ============================================================================
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ============================================================================
# MCP server (TypeScript → JS)
# ============================================================================
mcp-server/dist/
mcp-server/node_modules/
mcp-server/.tmp*

# ============================================================================
# Local development artifacts
# ============================================================================
.continue/                         # Continue agent state cache
logs/                               # autostart.log etc.
*.log.*                             # rotated log files
scripts/_*.out                     # PowerShell wrapper outputs
scripts/_*.txt
.vite/                              # Vite dev-server cache

# ============================================================================
# Playwright (E2E tests)
# ============================================================================
app/e2e/test-results/
app/playwright-report/
app/blob-report/
app/playwright/.cache/
.playwright-mcp/                    # Playwright MCP tooling screenshots

# ============================================================================
# Stray debug files (root + app)
# ============================================================================
admin-dashboard.png
login-page-fixed.png
check-e2e.cjs                            # one-off E2E debug script (do not commit)
.t.txt .l.txt .p.txt .d.txt        # one-letter log files

# Root-level tool output logs (mistakenly created by stray redirect)
/github-markdown.txt
/markdownlint-results.txt
/vitest-out.txt
/tc-out.txt
/build-out.txt
/eslint-out.txt

# Temporary commit helpers (created during restructure audits)
/commit-*.cjs
/git-status.cjs

# ============================================================================
# Editor / OS
# ============================================================================
/Thumbs.db
*.bak
*.swp
*.swo

# ============================================================================
# Runtime / session artifacts (never tracked)
# ============================================================================
screenshot*.png                     # session screenshots
*.tmp
*.bak2

# Local PostgreSQL data directories created during dev sessions
noufex_data/
default_pg_data/
