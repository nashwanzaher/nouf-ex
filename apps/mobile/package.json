{
	"name": "@noufex/mobile",
	"version": "0.1.0",
	"main": "index.ts",
	"private": true,
	"description": "Noufex mobile app — Expo SDK 51 (iOS + Android) with shared types from @noufex/shared.",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"build:preview": "eas build --profile preview --platform all",
		"build:prod": "eas build --profile production --platform all",
		"submit:ios": "eas submit --platform ios",
		"submit:android": "eas submit --platform android",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"test": "vitest run",
		"clean": "node -e \"require('node:fs').rmSync('node_modules/.tmp',{recursive:true,force:true})\""
	},
	"dependencies": {
		"@noufex/shared": "*",
		"@react-native-async-storage/async-storage": "1.23.1",
		"@react-navigation/native": "^7.0.13",
		"@react-navigation/native-stack": "^7.1.13",
		"@tanstack/react-query": "^5.59.20",
		"expo": "~51.0.39",
		"expo-constants": "~16.0.2",
		"expo-linking": "~6.3.1",
		"expo-localization": "~15.0.3",
		"expo-notifications": "~0.28.19",
		"expo-secure-store": "~13.0.2",
		"expo-splash-screen": "~0.27.7",
		"expo-status-bar": "~1.12.1",
		"i18next": "^26.3.1",
		"nativewind": "^4.1.23",
		"react": "18.2.0",
		"react-dom": "18.2.0",
		"react-i18next": "^17.0.8",
		"react-native": "0.74.5",
		"react-native-gesture-handler": "~2.16.1",
		"react-native-reanimated": "~3.10.1",
		"react-native-safe-area-context": "4.10.5",
		"react-native-screens": "3.31.1",
		"react-native-web": "~0.19.10",
		"tailwindcss": "^3.4.13",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@babel/core": "^7.25.2",
		"@noufex/eslint-config": "*",
		"@noufex/typescript-config": "*",
		"@types/react": "~18.2.79",
		"@vitest/coverage-v8": "^4.1.9",
		"eslint": "^9.39.1",
		"typescript": "~5.9.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}