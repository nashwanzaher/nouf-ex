{
  "default": true,
  "MD013": {
    "line_length": 200,
    "code_blocks": false,
    "tables": false,
    "headings": false
  },
  "MD033": {
    "allowed_elements": [
      "br",
      "kbd",
      "details",
      "summary",
      "sub",
      "sup",
      "div",
      "span",
      "a",
      "img",
      "iframe",
      "video",
      "audio",
      "table",
      "tr",
      "td",
      "th",
      "tbody",
      "thead",
      "code",
      "pre",
      "mark"
    ]
  },
  "MD041": false,
  "MD024": {
    "siblings_only": true
  },
  "MD025": {
    "front_matter_title": "^\\s*title\\s*[:=]"
  },
  "MD046": {
    "style": "fenced"
  },
  "MD048": {
    "style": "backtick"
  },
  "MD049": {
    "style": "underscore"
  },
  "MD050": {
    "style": "asterisk"
  },
  "MD060": false,
  "MD007": {
    "indent": 2
  },
  "MD004": {
    "style": "dash"
  },
  "MD009": {
    "br_spaces": 2,
    "list_item_empty_lines": false
  },
  "MD012": false,
  "MD032": false,
  "MD040": false,
  "MD034": false,
  "MD053": false,
  "MD045": false,
  "MD031": false,
  "MD036": false,
  "MD035": false,
  "MD014": false,
  "MD026": false,
  "MD030": false,
  "MD056": false,
  "MD058": false
}
