# ============================================================================
# Nouf-ex — environment variables template
# ----------------------------------------------------------------------------
# Copy to `.env` and adjust values as needed.
# Database: an existing PostgreSQL 17 instance reachable from the host.
# When the API runs inside Docker, set DB_HOST=host.docker.internal so it can
# reach the Postgres server running on the host machine.
# ============================================================================

# --- PostgreSQL (existing external server) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noufex_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/noufex_db

# --- Express API server ---
NODE_ENV=production
API_PORT=3000
HOST=0.0.0.0
SERVE_STATIC=true
