# =============================================================================
# n8n — Environment Override Template (EXAMPLE ONLY)
# =============================================================================
# هذا الملف EXAMPLE فقط — لا يحتوي على أي أسرار حقيقية.
# لاستخدامه:
#   1. انسخ هذا الملف:    cp n8n-env-override.env.example n8n-env-override.env
#   2. عبّئ القيم الحقيقية في النسخة الجديدة (لن تُرفع لـ git)
#   3. في n8n، استورد n8n-noufex-review-workflow.json
#      ووجّه الـ nodes لاستخدام هذا الملف كـ "Environment Override"
#
# ⚠️ لا ترفع n8n-env-override.env إلى git أبداً (مضاف ضمن .gitignore).
# =============================================================================

# --- PostgreSQL connection (للـ n8n لإجراء sanity checks فقط) -------------
POSTGRES_DB=noufex_db
POSTGRES_USER=<your-db-user>
POSTGRES_PASSWORD=<your-db-password>
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=noufex_db
DB_USER=<your-db-user>
DB_PASSWORD=<your-db-password>

# --- DATABASE_URL (صيغة postgresql:// للـ psql command في workflow) --------
# ملاحظة: يُفضّل استخدام دور noufex_app (least-privilege) للإنتاج.
#          استبدل القيم بين <...> بالقيم الحقيقية دون احتوائها هنا.
DATABASE_URL=postgresql://<db_user>:<db_password>@host.docker.internal:5432/noufex_db

# --- Runtime configuration (يجب أن يطابق docker-compose + .env) ----------
NODE_ENV=production
API_PORT=3000
HOST=0.0.0.0
SERVE_STATIC=true

# --- Auth secret (مطلوب ≥32 حرف — ولّد بقيمة حقيقية) ---------------------
# ولّد قيمة جديدة بأمان:
#   openssl rand -hex 32
# أو في PowerShell:
#   -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
AUTH_SECRET=<generate-with-openssl-rand-hex-32-min-32-chars>
