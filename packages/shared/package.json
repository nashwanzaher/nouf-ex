{
	"name": "@noufex/shared",
	"version": "0.0.0",
	"private": true,
	"description": "Shared types and utilities used by Nouf-ex web and api",
	"type": "module",
	"exports": {
		"./types": {
			"types": "./src/types/index.ts",
			"default": "./src/types/index.ts"
		},
		"./constants": {
			"types": "./src/constants.ts",
			"default": "./src/constants.ts"
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"clean": "rm -rf node_modules/.tmp"
	},
	"devDependencies": {
		"@noufex/eslint-config": "*",
		"@noufex/typescript-config": "*",
		"typescript": "~5.9.3"
	}
}
