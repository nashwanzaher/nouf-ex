{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "🚀 Start Full Stack (Docker)",
			"type": "shell",
			"command": "docker compose up -d --build",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "📜 Show Nouf-ex Container Logs",
			"type": "shell",
			"command": "docker logs -f Nouf-ex",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🛑 Stop Nouf-ex Container",
			"type": "shell",
			"command": "docker compose down",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🐚 Exec Into Nouf-ex Container",
			"type": "shell",
			"command": "docker exec -it Nouf-ex sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🗃️  Query Postgres (psql) on host",
			"type": "shell",
			"command": "psql -h localhost -U postgres -d noufex_db",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🧱 Apply Schema + Seed (db:setup)",
			"type": "shell",
			"command": "node scripts/db/db-setup.cjs",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "📦 Install Dependencies (root)",
			"type": "shell",
			"command": "npm install --no-audit --no-fund",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "📝 TypeScript Type Check",
			"type": "shell",
			"command": "npm run typecheck",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$tsc"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🔨 Build API Server (esbuild)",
			"type": "shell",
			"command": "npm run build --workspace @noufex/api",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🎨 Build Frontend (Vite)",
			"type": "shell",
			"command": "npm run build --workspace @noufex/web",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🧪 Run Vitest Tests",
			"type": "shell",
			"command": "npm test",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$vitest"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": {
				"kind": "test",
				"isDefault": true
			}
		},
		{
			"label": "👀 Vitest Watch Mode",
			"type": "shell",
			"command": "npm run test:watch",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$vitest"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"isBackground": true
		},
		{
			"label": "📊 Vitest Coverage",
			"type": "shell",
			"command": "npm run test:coverage",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$vitest"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🧹 Lint (ESLint)",
			"type": "shell",
			"command": "npm run lint",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$eslint-stylish"
			],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "🚀 Start API Server (tsx dev)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/maintenance/start-api.bat\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"isBackground": true
		},
		{
			"label": "🎨 Start Vite Dev Server (8080)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/maintenance/start-vite.bat\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"isBackground": true
		},
		{
			"label": "🧪 Test Stack (smoke)",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/quality/test-stack.ps1\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			}
		},
		{
			"label": "📝 Markdownlint Check (All Files)",
			"type": "shell",
			"command": "markdownlint-cli2 \"**/*.md\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "test"
		},
		{
			"label": "🔧 Markdownlint Fix (Auto)",
			"type": "shell",
			"command": "markdownlint-cli2 --fix \"**/*.md\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "build"
		},
		{
			"label": "📊 Markdownlint Stats by Rule",
			"type": "shell",
			"command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}/scripts/quality/analyze-markdownlint.ps1\"",
			"args": [],
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "🔍 Lint .github Folder Only",
			"type": "shell",
			"command": "markdownlint-cli2 \".github/**/*.md\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "test"
		},
		{
			"label": "🔍 Lint docs Folder Only",
			"type": "shell",
			"command": "markdownlint-cli2 \"docs/**/*.md\"",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"presentation": {
				"reveal": "always",
				"panel": "shared"
			},
			"group": "test"
		}
	]
}
