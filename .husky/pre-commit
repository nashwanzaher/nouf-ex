#!/usr/bin/env sh
# Pre-commit hook — runs `lint-staged` against any staged files,
# scoped to the workspace they belong to (apps/web, apps/api, etc.).
# Hooks dir is configured via `git config core.hooksPath .husky` —
# direct shell, no husky.sh shim needed since we only have one hook.
#
# What it does:
#   1. Re-stages the files lint-staged wants to touch (it adds them
#      back to the index after --fix / prettier --write).
#   2. Runs lint-staged against the staged subset. lint-staged looks
#      up the closest package.json to each file, so each app's own
#      lint / prettier config is honored automatically.
#
# To bypass locally (e.g. WIP commits): `git commit --no-verify`.

set -e

# Run from the monorepo root so lint-staged can resolve all workspaces.
npx lint-staged