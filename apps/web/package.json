{
	"name": "@noufex/web",
	"description": "Nouf-ex React + Vite storefront, admin, seller, and customer dashboards",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.18.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview": "vite preview",
		"images:populate": "node scripts/populate-product-images.cjs",
		"test": "vitest run",
		"test:a11y": "vitest run --dir src/__tests__/a11y",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"clean": "rm -rf dist node_modules/.tmp"
	},
	"dependencies": {
		"@fontsource/amiri": "^5.2.8",
		"@fontsource/cairo": "^5.2.7",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"embla-carousel-react": "^8.6.0",
		"framer-motion": "^12.40.0",
		"gsap": "^3.15.0",
		"i18next": "^26.3.1",
		"i18next-browser-languagedetector": "^8.2.1",
		"lucide-react": "^0.562.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-i18next": "^17.0.8",
		"react-router": "^7.6.1",
		"recharts": "^2.15.4",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@noufex/eslint-config": "*",
		"@noufex/typescript-config": "*",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.1",
		"@vitest/coverage-v8": "^4.1.9",
		"autoprefixer": "^10.4.23",
		"axe-core": "^4.12.1",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"happy-dom": "^20.10.6",
		"msw": "^2.14.6",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^7.2.4",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.9",
		"vitest-axe": "^0.1.0"
	}
}
