{
	"name": "@noufex/db",
	"description": "Nouf-ex PostgreSQL schema, migrations, and seed data",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.18.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"db:setup": "node ../../scripts/db/db-setup.cjs",
		"migrate": "node ../../scripts/db/migrate.cjs",
		"seed": "psql -f seed.sql",
		"clean": "node -e \"require('node:fs').rmSync('node_modules/.tmp',{recursive:true,force:true})\""
	},
	"files": [
		"schema.sql",
		"schema-extra.sql",
		"functions.sql",
		"triggers.sql",
		"views.sql",
		"roles.sql",
		"seed.sql",
		"migrations/**/*"
	]
}
