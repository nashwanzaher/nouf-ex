.env
.vs/
.vscode/*.log
node_modules/
bin/
obj/
dist/
build/
__pycache__/
*.pyc
.DS_Store
*.db
*.db-journal
*.db-shm
*.db-wal
*.log
coverage/
.env.local
app/server/index.js

# MkDocs build output (created by `mkdocs build` or `mkdocs gh-deploy`).
# Lives next to mkdocs.yml in the repo root.
site/

# Python virtualenv for the docs build (created by `python -m venv .venv`).
.venv/
venv/
env/

# mypy / ruff caches.
.mypy_cache/
.ruff_cache/
.pytest_cache/

# mkdocs strict-mode verbose logs.
.mkdocs_*

# MCP server (TypeScript → JS)
mcp-server/dist/
mcp-server/node_modules/
mcp-server/.tmp*

# Continue (agent state caches, regenerated on every editor session)
.continue/

# PowerShell wrapper script outputs (regenerated on every run via `> $file`)
scripts/_*.out
scripts/_*.txt

# Local logs (e.g. logs/autostart.log from scripts/autostart.ps1)
logs/
*.log.*

# Playwright (e2e tests)
# test-results/ holds the per-test JSON Playwright writes after every
# run. The HTML report (playwright-report/) is in the project root and
# not gitignored because some teams commit the latest known-good report.
app/e2e/test-results/
app/playwright-report/
app/blob-report/
app/playwright/.cache/

# Playwright MCP tooling (in-editor browser navigation, console logs,
# screenshots). These are regenerated every time Copilot Chat uses the
# browser tool and have no value in version control.
.playwright-mcp/

# Vite dev-server cache (regenerated on every `vite` start; nothing to
# review). Lives next to vite.config.ts and is harmless to leave on
# disk, but should not be in version control.
.vite/

# Standalone screenshots captured during interactive debugging.
admin-dashboard.png
login-page-fixed.png
.playwright-mcp/
.t.txt
.l.txt
.p.txt
.d.txt

# 2026-07-03 restructure cleanup
# Root-level tool output logs (mistakenly created at root by stray redirect)
/github-markdown.txt
/markdownlint-results.txt
/vitest-out.txt
/tc-out.txt
/build-out.txt
/eslint-out.txt

# Orphan CJS bundle from legacy scripts/build-api.bat (no longer produced)
/app/server/index.cjs

# Temporary commit helpers created during restructure audits
/commit-*.cjs
/git-status.cjs

# Editor / OS backup files (missing pre-existing patterns)
/Thumbs.db
*.bak
*.swp
*.swo
