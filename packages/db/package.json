{
	"name": "@noufex/db",
	"description": "Noufex PostgreSQL schema, migrations, and seed data",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.18.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"db:setup": "node ../../scripts/db/db-setup.cjs",
		"migrate": "node ../../scripts/db/migrate.cjs",
		"bootstrap:admin": "node ../../scripts/db/bootstrap-admin.cjs",
		"reference-seed": "psql -f reference-seed.sql",
		"demo-seed": "NODE_ENV=development node ../../scripts/db/run-demo-seed.cjs",
		"seed": "npm run reference-seed && npm run demo-seed",
		"clean": "node -e \"require('node:fs').rmSync('node_modules/.tmp',{recursive:true,force:true})\""
	},
	"files": [
		"schema.sql",
		"schema-extra.sql",
		"functions.sql",
		"triggers.sql",
		"views.sql",
		"roles.sql",
		"reference-seed.sql",
		"demo-seed.sql",
		"migrations/**/*"
	]
}
