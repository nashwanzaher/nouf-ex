# ============================================================================
# Anything not needed to build or run the API image.
# ----------------------------------------------------------------------------
# The Dockerfile only COPYs `app/`, so everything outside it is excluded
# from the build context. This keeps the context < 10 MB instead of 300+.
# ============================================================================

# Dependencies
**/node_modules/
**/node_modules

# Build output
dist/
build/
out/

# Environment & secrets
.env
.env.local
.env.*.local

# Logs and caches
*.log
.npm
.eslintcache
*.tsbuildinfo
.DS_Store
Thumbs.db

# VCS / editor
.git/
.gitignore
.gitattributes
.vs/
.vscode/
.idea/

# Test artifacts
.coverage/
app/coverage/
coverage/

# Provisioning / scripts not needed at runtime
database/
app/scripts/
# Keep the docker entrypoint in the build context. Everything else
# under scripts/ is for the host (db setup, lint, typecheck, etc.) and
# does NOT need to ship in the runtime image.
!scripts/devops/docker-entrypoint.sh

# MCP server (separate process, runs on host, not in this image)
mcp-server/

# Legacy / archived research docs
# (archive/ removed 2026-07-07; docs/research/ no longer exists)
