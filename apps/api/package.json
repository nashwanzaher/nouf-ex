{
	"name": "@noufex/api",
	"description": "Noufex Express REST API",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "^20.19.0 || >=22.12.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"start": "NODE_ENV=production tsx src/index.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --packages=external",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('node_modules/.tmp',{recursive:true,force:true})\""
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^8.0.0",
		"@elastic/elasticsearch": "^8.15.0",
		"@opentelemetry/api": "^1.9.0",
		"@opentelemetry/auto-instrumentations-node": "^0.50.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.54.0",
		"@opentelemetry/resources": "^1.27.0",
		"@opentelemetry/sdk-node": "^0.54.0",
		"@opentelemetry/sdk-trace-base": "^1.27.0",
		"@opentelemetry/semantic-conventions": "^1.27.0",
		"@sentry/node": "^8.40.0",
		"amqplib": "^0.10.4",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"ioredis": "^5.4.1",
		"multer": "^2.0.0",
		"node-cron": "^4.6.0",
		"openapi-response-validator": "^2.0.0",
		"pg": "^8.22.0",
		"prom-client": "^15.1.3",
		"swagger-ui-express": "^5.0.1",
		"ws": "^8.0.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@noufex/eslint-config": "*",
		"@noufex/typescript-config": "*",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/multer": "^2.0.0",
		"@types/node": "^24.10.1",
		"@types/node-cron": "^3.0.11",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.3",
		"@types/swagger-ui-express": "^4.1.7",
		"@types/ws": "^8.18.0",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.1",
		"supertest": "^7.2.2",
		"tsx": "^4.22.4",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vitest": "^4.1.9"
	}
}
