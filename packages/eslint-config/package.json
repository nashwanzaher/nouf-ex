{
	"name": "@noufex/eslint-config",
	"version": "0.0.0",
	"private": true,
	"description": "Shared ESLint configurations for Noufex workspaces",
	"type": "module",
	"main": "./index.js",
	"exports": {
		".": "./index.js",
		"./react": "./react.js",
		"./node": "./node.js"
	},
	"files": [
		"index.js",
		"react.js",
		"node.js"
	],
	"scripts": {
		"clean": "node -e \"require('node:fs').rmSync('node_modules/.tmp',{recursive:true,force:true})\""
	},
	"dependencies": {
		"@eslint/js": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"typescript-eslint": "^8.46.4"
	},
	"peerDependencies": {
		"eslint": ">=9"
	}
}
