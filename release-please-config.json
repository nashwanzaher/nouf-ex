{
  "_comment": [
    "release-please configuration — automates CHANGELOG.md entries",
    "and SemVer tagging from Conventional Commits. Replaces the",
    "manual '[Unreleased]' workflow described in MASTER_PLAN §11.6.",
    "Boots when enabled: install GitHub App or run CLI; see",
    "https://github.com/googleapis/release-please."
  ],
  "release-type": "node",
  "package-name": "Noufex",
  "changelog-path": "CHANGELOG.md",
  "versioning": "default",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore(main): release${scope} ${version}",
  "pull-request-header": ":robot: Release PR — review & merge to publish.",
  "pull-request-footer": "Generated by release-please from Conventional Commits on main.",
  "tags": [
    "v*.*.*"
  ],
  "branches": [
    "main"
  ],
  "extra-files": [
    "docs/MASTER_PLAN.md",
    "docs/STRUCTURE.md"
  ],
  "packages": {
    ".": {
      "path": "app",
      "package-name": "Noufex",
      "release-type": "node"
    }
  }
}
