{
	"name": "my-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"preview": "vite preview",
		"api": "tsx server/index.ts",
		"api:prod": "NODE_ENV=production tsx server/index.ts",
		"api:build": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=server/index.js --packages=external",
		"db:setup": "node ../scripts/db-setup.cjs",
		"images:populate": "node scripts/populate-product-images.cjs",
		"test": "vitest run",
		"test:unit": "vitest run --exclude 'server/tests/api-server.test.ts'",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui"
	},
