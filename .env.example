# ============================================================================
# Noufex — environment variables template
# ----------------------------------------------------------------------------
# Yemen & Middle East B2B/B2C e-commerce marketplace platform.
# Copy to `.env` and adjust values. Real passwords go in `.env` only
# (which is gitignored). `.env.example` ships with placeholders.
#
# Quick start:
#   1. cp .env.example .env
#   2. Fill in DB_PASSWORD and AUTH_SECRET (≥32 chars).
#   3. Start PostgreSQL: docker run -d --name noufex-postgres \
#        -e POSTGRES_PASSWORD=$POSTGRES_PASSWORD -p 5432:5432 postgres:17
#   4. Run db:setup:    node scripts/db/db-setup.cjs
#   5. Start the API:   docker compose up -d
# ============================================================================

# --- Database ---
# The app connects as the dedicated least-privilege role `noufex_app`.
# Run `node scripts/db/db-setup.cjs` ONCE on the host as the `postgres`
# superuser to create the role + schema + seed (see packages/db/roles.sql
# and packages/db/seed.sql).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noufex_db
DB_USER=noufex_app
DB_PASSWORD=CHANGE_ME_APP
DATABASE_URL=postgresql://noufex_app:CHANGE_ME_APP@localhost:5432/noufex_db
# Set to "true" in production when Postgres requires TLS.
DB_SSL=true

# --- Express API server ---
NODE_ENV=development
API_PORT=3000
HOST=0.0.0.0
SERVE_STATIC=true

# --- CORS ---
# Comma-separated list of allowed CORS origins.
# Example: https://noufex.example.com,https://admin.noufex.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- Logging ---
# Logging level: debug | info | warn | error
LOG_LEVEL=info

# --- Trust Proxy ---
# Set to 'true' / '1' / 'loopback' / CIDR list when running behind
# nginx, k8s ingress, or a load balancer. Without it, req.ip collapses
# to 127.0.0.1 for every request, breaking rate-limiting and audit logs.
TRUST_PROXY=

# --- Auth ---
# HMAC signing key for bearer tokens (>=32 random chars). REQUIRED in production.
# docker-compose.yml reads this from the host's .env via ${AUTH_SECRET}.
# IMPORTANT: this placeholder is intentionally < 32 chars so the application
# refuses to start until you replace it. Generate a real one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=<REPLACE-WITH-32-PLUS-RANDOM-CHARS>

# --- Redis (Phase 1, competitive-architecture-analysis) ---
# Optional. When unset, the API runs in DB-only mode and every cache /
# rate-limit-fast-path / session-cache call falls back to the database.
# In production, point this at the redis service in docker-compose.
# Format: redis://[:password@]host:port[/db]
REDIS_URL=redis://localhost:6379
# Optional: override the auto-applied key prefix (default "noufex:").
# REDIS_KEY_PREFIX=noufex:
# REDIS_MAX_RETRIES=2
# REDIS_CONNECT_TIMEOUT_MS=5000

# --- RabbitMQ (Phase 2, async messaging) ---
# Optional. When unset, async side-effects (email, indexing, analytics)
# are dispatched in-process via an in-memory queue.
# Format: amqp://user:pass@host:port[/vhost]
RABBITMQ_URL=amqp://noufex_app:CHANGE_ME_RABBIT@localhost:5672/noufex
RABBITMQ_PREFETCH=10

# --- Elasticsearch (Phase 3, advanced search) ---
# Optional. When unset, search falls back to the PostgreSQL FTS path
# (migration 0009). In production, point this at the elasticsearch
# service in docker-compose.
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=noufex

# --- Cloudflare (Phase 4, edge caching) ---
# Optional. Used by the optional Cloudflare purge integration in the
# admin router. Leave empty to disable purge-from-origin.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=

# --- Admin scripts (optional) ---
# The scripts/ helpers (audit-db.cjs, drop-test-db.cjs, verify-fresh.cjs)
# need to connect as the `postgres` superuser, not as `noufex_app`, because
# they run schema introspection, drop databases, and (for db:setup) create
# roles. The application code never reads these — the API always uses
# DATABASE_URL above. If you don't run those scripts, you can leave these
# unset.
#
# POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD mirror the env vars
# `docker run postgres:17` accepts; the admin scripts translate them
# into a connection string at runtime.
POSTGRES_DB=noufex_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
