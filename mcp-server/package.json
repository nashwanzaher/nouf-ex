{
	"name": "noufex-mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Model Context Protocol server for deep introspection of the Nouf-ex codebase and the noufex_db PostgreSQL database.",
	"type": "module",
	"bin": {
		"noufex-mcp": "dist/index.js"
	},
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"start": "node dist/index.js",
		"dev": "tsx src/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.0.4",
		"dotenv": "^17.4.2",
		"pg": "^8.22.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"@types/pg": "^8.20.0",
		"tsx": "^4.22.4",
		"typescript": "~6.0.3"
	}
}
