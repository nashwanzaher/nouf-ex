{
	"name": "@noufex/app",
	"description": "Nouf-ex - Yemen & Middle East B2B/B2C marketplace (React 19 + Vite 7 frontend, Express 5 + PostgreSQL 17 backend)",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.18.0 <21.0.0",
		"npm": ">=10.0.0"
	},
	"keywords": [
		"ecommerce",
		"marketplace",
		"b2b",
		"b2c",
		"yemen",
		"middle-east",
		"react",
		"express",
		"postgresql",
		"i18n",
		"arabic",
		"rtl"
	],
	"author": "Nouf-ex Team",
	"license": "UNLICENSED",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"typecheck": "tsc -b --noEmit",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview": "vite preview",
		"api": "tsx server/index.ts",
		"api:prod": "NODE_ENV=production tsx server/index.ts",
		"api:build": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=server/index.js --packages=external",
		"db:setup": "node ../scripts/db/db-setup.cjs",
		"images:populate": "node scripts/populate-product-images.cjs",
		"test": "vitest run",
		"test:unit": "vitest run --exclude 'server/tests/api-server.test.ts'",
		"test:a11y": "vitest run --dir src/__tests__/a11y",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"prepare": "husky",
		"pre-commit": "lint-staged",
		"docs:install": "pip install -r ../requirements-docs.txt",
		"docs:serve": "mkdocs serve",
		"docs:build": "mkdocs build --strict",
		"docs:deploy": "mkdocs gh-deploy --strict --force"
	},
	"dependencies": {
		"@fontsource/amiri": "^5.2.8",
		"@fontsource/cairo": "^5.2.7",
		"@fontsource/jetbrains-mono": "^5.2.8",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"embla-carousel-react": "^8.6.0",
		"express": "^5.2.1",
		"framer-motion": "^12.40.0",
		"gsap": "^3.15.0",
		"i18next": "^26.3.1",
		"i18next-browser-languagedetector": "^8.2.1",
		"lucide-react": "^0.562.0",
		"pg": "^8.22.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-i18next": "^17.0.8",
		"react-router": "^7.6.1",
		"recharts": "^2.15.4",
		"tailwind-merge": "^3.4.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@testing-library/user-event": "^14.6.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"@types/supertest": "^6.0.3",
		"@vitejs/plugin-react": "^5.1.1",
		"@vitest/coverage-v8": "^4.1.9",
		"autoprefixer": "^10.4.23",
		"axe-core": "^4.12.1",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"happy-dom": "^20.10.6",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.8",
		"msw": "^2.14.6",
		"postcss": "^8.5.6",
		"prettier": "^3.6.2",
		"supertest": "^7.2.2",
		"tailwindcss": "^3.4.19",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.22.4",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vite": "^7.2.4",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.9",
		"vitest-axe": "^0.1.0"
	},
	"lint-staged": {
		"*.{ts,tsx,cts}": [
			"eslint --fix --max-warnings=0",
			"prettier --write"
		],
		"*.{js,cjs,mjs,json,md,css}": [
			"prettier --write"
		]
	}
}
