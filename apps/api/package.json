{
	"name": "@noufex/api",
	"description": "Nouf-ex Express REST API",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.18.0",
		"npm": ">=10.0.0"
	},
	"scripts": {
		"dev": "tsx src/index.ts",
		"start": "NODE_ENV=production tsx src/index.ts",
		"build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/index.js --packages=external",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"clean": "rm -rf dist node_modules/.tmp"
	},
	"dependencies": {
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"pg": "^8.22.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@noufex/eslint-config": "*",
		"@noufex/typescript-config": "*",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^6.0.3",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.1",
		"supertest": "^7.2.2",
		"tsx": "^4.22.4",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.46.4",
		"vitest": "^4.1.9"
	}
}
