{
	"name": "@noufex/api-client",
	"version": "0.1.0",
	"private": true,
	"description": "TypeScript SDK auto-generated from the Noufex OpenAPI 3.1 spec (single source of truth for web + mobile clients).",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"scripts": {
		"generate": "openapi-typescript ./openapi.generated.json --output ./src/schema.d.ts --enum --alphabetize",
		"generate:remote": "openapi-typescript http://localhost:3000/api/openapi.json --output ./src/schema.d.ts --enum --alphabetize",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"lint": "eslint .",
		"test": "vitest run",
		"clean": "node -e \"require('node:fs').rmSync('node_modules/.tmp',{recursive:true,force:true})\""
	},
	"dependencies": {
		"openapi-fetch": "^0.13.8"
	},
	"devDependencies": {
		"@noufex/eslint-config": "*",
		"@noufex/typescript-config": "*",
		"@types/node": "^24.10.1",
		"openapi-typescript": "^7.4.4",
		"typescript": "~5.9.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	}
}
